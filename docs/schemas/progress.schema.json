{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "contentId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
          },
          "contentVersion": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "puzzle",
              "opening"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "diagnostic",
              "practice",
              "opening"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 604800000
          },
          "attempts": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "uci": {
                  "type": "string",
                  "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
                },
                "san": {
                  "type": "string",
                  "maxLength": 20
                },
                "fen": {
                  "type": "string",
                  "maxLength": 150
                },
                "correct": {
                  "type": "boolean"
                },
                "at": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "uci",
                "san",
                "fen",
                "correct",
                "at"
              ],
              "additionalProperties": false
            }
          },
          "hints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "outcome": {
            "type": "string",
            "enum": [
              "solved",
              "revealed"
            ]
          },
          "firstMove": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "playedLine": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
            }
          }
        },
        "required": [
          "schemaVersion",
          "id",
          "sessionId",
          "contentId",
          "contentVersion",
          "kind",
          "mode",
          "category",
          "startedAt",
          "completedAt",
          "durationMs",
          "attempts",
          "hints",
          "outcome",
          "firstMove",
          "playedLine"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "events"
  ],
  "additionalProperties": false
}
