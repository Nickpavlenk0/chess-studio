{
  "name": "chess-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint .",
    "validate": "tsx scripts/validate-content.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run schemas:check && npm run validate && npm test && npm run build",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "schemas": "tsx scripts/generate-schemas.ts",
    "schemas:check": "tsx scripts/generate-schemas.ts --check",
    "format": "prettier --write src worker tests e2e scripts/*.ts *.ts *.json .github"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-chessboard": "^5.8.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  }
}
